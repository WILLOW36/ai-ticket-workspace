# AI provider utilizado por la aplicación.
# mock = modo local/demo sin credenciales de API externas para que el proyecto funcione gratis y sin credenciales de la clave API de Gemini.
# gemini = clasificación real de Gemini AI cuando tengas una credencial funcional .
AI_PROVIDER=mock

# PostgreSQL configuración
POSTGRES_DB=ai_ticket_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django configuración
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production

# Gemini API key.
# Requerido solo cuando AI_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key